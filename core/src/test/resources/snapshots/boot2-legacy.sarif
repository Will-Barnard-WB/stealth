{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "stealth",
          "semanticVersion": "test",
          "informationUri": "https://github.com/Will-Barnard-WB/stealth",
          "rules": [
            {
              "id": "deps/outdated-major",
              "name": "OutdatedMajor",
              "shortDescription": {
                "text": "Major version behind"
              },
              "fullDescription": {
                "text": "A newer major release is available."
              },
              "helpUri": "https://github.com/Will-Barnard-WB/stealth/blob/main/docs/rules/deps.md#deps-outdated-major",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "maintainability",
                  "dependency"
                ],
                "precision": "high",
                "stealthRuleId": "deps/outdated-major",
                "stealthCategory": "tech"
              }
            },
            {
              "id": "deps/outdated-minor",
              "name": "OutdatedMinor",
              "shortDescription": {
                "text": "Minor version behind"
              },
              "fullDescription": {
                "text": "A newer minor release is available."
              },
              "helpUri": "https://github.com/Will-Barnard-WB/stealth/blob/main/docs/rules/deps.md#deps-outdated-minor",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "maintainability",
                  "dependency"
                ],
                "precision": "high",
                "stealthRuleId": "deps/outdated-minor",
                "stealthCategory": "tech"
              }
            },
            {
              "id": "vuln/known-vulnerability/GHSA-j288-q9x7-2f5v",
