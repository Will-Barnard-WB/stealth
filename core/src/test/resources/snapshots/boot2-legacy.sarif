              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "dependency"
                ],
                "precision": "high",
                "security-severity": "6.5",
                "stealthRuleId": "vuln/known-vulnerability",
