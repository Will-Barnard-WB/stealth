{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Will-Barnard-WB/stealth/blob/main/docs/schema/stealth-yml.schema.json",
  "title": ".stealth.yml",
  "description": "Per-repository settings for stealth doctor. See ADR-0004 and the README.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1, "description": "Schema version. Required; 1 for now." },
    "ignore": {
      "description": "Paths no analyzer looks at: gitignore-style globs relative to the repo root. A glob matching a Maven module directory excludes that module.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "severity": {
      "description": "Rule id -> severity override. off drops the rule.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "enum": ["critical", "high", "medium", "low", "info", "off"] }
    },
    "allow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{ "required": ["path"] }, { "required": ["fingerprint"] }],
            "properties": {
              "path": { "type": "string", "minLength": 1, "description": "Glob of the files it covers." },
              "fingerprint": { "type": "string", "pattern": "^v[0-9]+:[0-9a-f]+$" },
              "rules": { "$ref": "#/$defs/rules" },
              "reason": { "type": "string", "minLength": 1 },
              "expires": { "$ref": "#/$defs/date" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{ "required": ["component"] }, { "required": ["advisory"] }],
            "properties": {
              "component": { "type": "string", "pattern": "^pkg:", "description": "Package URL; no @version means any version." },
              "advisory": { "type": "string", "minLength": 1, "description": "Advisory id or alias, e.g. GHSA-... or CVE-..." },
              "rules": { "$ref": "#/$defs/rules" },
              "reason": { "type": "string", "minLength": 1 },
              "expires": { "$ref": "#/$defs/date" }
            }
          }
        }
      }
    },
    "analyzers": {
      "description": "Per-analyzer settings. Every analyzer accepts enabled; some have thresholds.",
      "type": "object",
      "properties": {
        "maintenance": {
          "type": "object", "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "stale-after": { "$ref": "#/$defs/period" } }
        },
        "duplication": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "min-tokens": { "type": "integer", "minimum": 1 },
            "include-tests": { "type": "boolean" }
          }
        },
        "hygiene": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "stale-branch-after": { "$ref": "#/$defs/period" },
            "large-file-bytes": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": { "enabled": { "type": "boolean" } }
      }
    },
    "eol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "java-distribution": { "type": "string", "description": "endoflife.date product whose dates apply, e.g. eclipse-temurin, oracle-jdk." },
        "java-version": { "type": "string", "description": "The Java release the repo runs on, when it isn't the compile target." }
      }
    },
    "fail-under": {
      "description": "CI gate: minimum overall score, or per-category minimums. --fail-under N replaces overall.",
      "oneOf": [
        { "$ref": "#/$defs/score" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overall": { "$ref": "#/$defs/score" },
            "security": { "$ref": "#/$defs/score" },
            "tech": { "$ref": "#/$defs/score" }
          }
        }
      ]
    }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rules": { "type": "array", "items": { "type": "string" } },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "period": { "type": "string", "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?$" }
  }
}
